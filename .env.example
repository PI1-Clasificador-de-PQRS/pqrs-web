# Copia este archivo a .env.local para desarrollo. Todas las variables son SOLO del servidor:
# nunca uses el prefijo NEXT_PUBLIC_ para ellas.

# development | staging | production. Fuera de "development" la aplicación no arranca si falta
# API_BASE_URL o PROXY_SHARED_SECRET, o si WEB_TRUSTED_PROXY_HOPS es 0.
ENVIRONMENT=development

# URL base de pqrs-api (sin /api/v1).
API_BASE_URL=http://localhost:8000

# Secreto compartido con pqrs-api (su PROXY_SHARED_SECRET). En el docker-compose.yml de la API
# vale dev-proxy-secret-solo-para-local.
PROXY_SHARED_SECRET=dev-proxy-secret-solo-para-local

# Nombre de la cookie de sesión que fija la API.
SESSION_COOKIE_NAME=pqrs_session

# Cuántos proxies de confianza hay delante del dashboard. Se toma la entrada N contando desde la
# derecha de X-Forwarded-For.
#   0 -> SOLO desarrollo local, sin nada delante de Next. Se usa X-Forwarded-For únicamente si
#        tiene exactamente una entrada (la que pone Next con la IP del socket cuando el navegador
#        no envía la cabecera); en cualquier otro caso no se envía la IP a la API.
#   1 -> Azure Container Apps (la ingress agrega la IP real a la derecha).
# Fuera de "development" debe ser >= 1. Leer la IP del socket (con un preload de Node) solo haría
# falta si el dashboard se expusiera sin ningún proxy delante, lo que no es el caso.
WEB_TRUSTED_PROXY_HOPS=0
